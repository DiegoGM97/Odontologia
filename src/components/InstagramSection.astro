---
import { instagram, instagramPosts } from "../data/site";
---

<section id="instagram" class="py-24 px-4 md:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center gap-2 bg-gradient-to-r from-[#D4AF77]/15 to-[#C9B498]/15 px-5 py-2.5 rounded-full mb-6 border border-[#D4AF77]/20"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-[#D4AF77]"
          aria-hidden="true"
        >
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
        </svg>
        <span class="text-[#1B2B3A] font-medium tracking-wide text-sm">
          @{instagram.username}
        </span>
      </div>
      <h2 class="text-4xl md:text-5xl text-[#1B2B3A] mb-4 font-medium">
        Síguenos en Instagram
      </h2>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto">
        Casos reales, consejos de salud bucal y el día a día de nuestra clínica en Bogotá.
      </p>
    </div>

    <div class="instagram-track overflow-hidden" data-instagram>
      <div
        class="instagram-inner flex gap-6 transition-transform duration-500 ease-in-out"
      >
        {
          instagramPosts.map((post) => (
            <div class="instagram-slide flex-shrink-0 w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]">
              <a
                href={post.permalink}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col h-full bg-white rounded-2xl overflow-hidden shadow-md border border-gray-100 hover:border-[#D4AF77]/50 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300"
              >
            <div class="relative aspect-square overflow-hidden bg-[#F8F8F8]">
              <img
                src={post.imageUrl}
                alt={post.caption}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1B2B3A]/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <span class="flex items-center justify-center w-9 h-9 rounded-full bg-white/95 shadow-lg">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="text-[#1B2B3A]"
                    aria-hidden="true"
                  >
                    <path d="M15 3h6v6" />
                    <path d="M10 14 21 3" />
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  </svg>
                </span>
              </div>
            </div>

            <div class="p-5 flex flex-col flex-1">
              <span class="text-xs text-gray-400 mb-3 block">{post.timeAgo}</span>

              <p class="text-gray-600 text-sm leading-relaxed line-clamp-2 flex-1">
                {post.caption}
              </p>

              <span class="mt-4 text-xs font-medium text-[#D4AF77] group-hover:text-[#C9B498] transition-colors">
                Ver en Instagram →
              </span>
            </div>
              </a>
            </div>
          ))
        }
      </div>
      <div class="flex justify-center gap-2 mt-8" data-instagram-dots></div>
    </div>

    <div class="text-center mt-14">
      <a
        href={instagram.profileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-gradient-to-r from-[#D4AF77] to-[#C9B498] text-white px-8 py-4 rounded-full hover:shadow-xl hover:scale-[1.02] transition-all duration-300 font-medium"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
        </svg>
        Seguir @{instagram.username}
      </a>
    </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>("[data-instagram]");
  const inner = track?.querySelector<HTMLElement>(".instagram-inner");
  const dotsContainer = track?.querySelector<HTMLElement>("[data-instagram-dots]");
  const slides = inner?.querySelectorAll<HTMLElement>(".instagram-slide");

  if (track && inner && dotsContainer && slides && slides.length > 0) {
    let current = 0;
    let autoplayTimer: ReturnType<typeof setInterval>;

    const getSlidesPerView = () => {
      if (window.matchMedia("(min-width: 1024px)").matches) return 3;
      if (window.matchMedia("(min-width: 640px)").matches) return 2;
      return 1;
    };

    const maxIndex = () => Math.max(0, slides.length - getSlidesPerView());

    const goTo = (index: number) => {
      current = Math.max(0, Math.min(index, maxIndex()));
      const slideWidth = slides[0].offsetWidth + 24;
      inner.style.transform = `translateX(-${current * slideWidth}px)`;
      dotsContainer.querySelectorAll("button").forEach((btn, i) => {
        btn.classList.toggle("bg-[#D4AF77]", i === current);
        btn.classList.toggle("bg-gray-300", i !== current);
      });
    };

    const buildDots = () => {
      dotsContainer.innerHTML = "";
      for (let i = 0; i <= maxIndex(); i++) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = `w-2.5 h-2.5 rounded-full transition-colors ${i === current ? "bg-[#D4AF77]" : "bg-gray-300"}`;
        dot.setAttribute("aria-label", `Ir a la publicación ${i + 1}`);
        dot.addEventListener("click", () => {
          goTo(i);
          resetAutoplay();
        });
        dotsContainer.appendChild(dot);
      }
    };

    const startAutoplay = () => {
      autoplayTimer = setInterval(() => {
        goTo(current >= maxIndex() ? 0 : current + 1);
      }, 5000);
    };

    const resetAutoplay = () => {
      clearInterval(autoplayTimer);
      startAutoplay();
    };

    buildDots();
    startAutoplay();

    window.addEventListener("resize", () => {
      buildDots();
      goTo(Math.min(current, maxIndex()));
    });

    track.addEventListener("mouseenter", () => clearInterval(autoplayTimer));
    track.addEventListener("mouseleave", startAutoplay);
  }
</script>
