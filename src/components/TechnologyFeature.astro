---
import Icon from "./Icon.astro";
import type { IconName } from "../types/icons";

interface Props {
  icon: IconName;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div
  class="flex items-start gap-4 p-6 bg-[#F8F8F8] rounded-lg hover:bg-white hover:shadow-md transition-all duration-300"
>
  <div
    class="flex-shrink-0 w-12 h-12 bg-[#1B2B3A] rounded-lg flex items-center justify-center"
  >
    <Icon name={icon} size={24} class="text-[#D4AF77]" strokeWidth={1.5} />
  </div>
  <div>
    <h4 class="text-lg mb-2 text-[#1B2B3A]">{title}</h4>
    <p class="text-sm text-gray-600 leading-relaxed">{description}</p>
  </div>
</div>
