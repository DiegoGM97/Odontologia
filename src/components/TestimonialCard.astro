---
interface Props {
  name: string;
  testimonial: string;
  timeAgo: string;
  image?: string;
  rating?: number;
  reviewCount?: number;
  localGuide?: boolean;
}

const { name, testimonial, timeAgo, image, rating = 5, reviewCount, localGuide } = Astro.props;

const initials = name
  .split(" ")
  .map((part) => part.charAt(0))
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<article class="bg-white rounded-xl border border-gray-200 p-4 h-full flex flex-col">
  <div class="flex items-start gap-3">
    {
      image ? (
        <img
          src={image}
          alt=""
          width={40}
          height={40}
          class="w-10 h-10 rounded-full object-cover shrink-0"
          loading="lazy"
        />
      ) : (
        <div
          class="w-10 h-10 rounded-full bg-[#1a73e8] text-white text-sm font-medium flex items-center justify-center shrink-0"
          aria-hidden="true"
        >
          {initials}
        </div>
      )
    }

    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <h4 class="text-sm font-medium text-[#202124] truncate">{name}</h4>
          {
            localGuide ? (
              <p class="text-xs text-[#5f6368]">Guía local</p>
            ) : reviewCount ? (
              <p class="text-xs text-[#5f6368]">{reviewCount} reseñas</p>
            ) : null
          }
        </div>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
          class="shrink-0"
        >
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
        </svg>
      </div>

      <div class="flex items-center flex-wrap gap-x-2 gap-y-1 mt-1.5">
        <div class="flex items-center gap-0.5" aria-label={`${rating} de 5 estrellas`}>
          {
            Array.from({ length: 5 }).map((_, i) => (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                aria-hidden="true"
                class={i < rating ? "text-[#FBBC04]" : "text-[#dadce0]"}
              >
                <path
                  fill="currentColor"
                  d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                />
              </svg>
            ))
          }
        </div>
        <span class="text-xs text-[#5f6368]">{timeAgo}</span>
      </div>
    </div>
  </div>

  <p class="mt-3 text-sm text-[#3c4043] leading-relaxed line-clamp-5 flex-1">{testimonial}</p>
</article>
