---
import type { BlogPost } from "../data/blog";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<article class="bg-white rounded-2xl overflow-hidden shadow-md border border-gray-100 hover:shadow-xl hover:border-[#D4AF77]/40 transition-all duration-300 flex flex-col h-full">
  <a href={`/blog/${post.slug}`} class="block aspect-[16/10] overflow-hidden">
    <img
      src={post.image}
      alt={post.title}
      class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
  </a>
  <div class="p-6 flex flex-col flex-1">
    <div class="flex items-center gap-3 text-xs text-gray-500 mb-3">
      <span class="text-[#D4AF77] font-medium">{post.category}</span>
      <span>·</span>
      <span>{post.date}</span>
      <span>·</span>
      <span>{post.readTime}</span>
    </div>
    <h2 class="text-xl text-[#1B2B3A] font-medium mb-3 leading-snug">
      <a href={`/blog/${post.slug}`} class="hover:text-[#D4AF77] transition-colors">
        {post.title}
      </a>
    </h2>
    <p class="text-gray-600 text-sm leading-relaxed flex-1 mb-4">{post.excerpt}</p>
    <a
      href={`/blog/${post.slug}`}
      class="text-[#D4AF77] hover:text-[#C9B498] font-medium text-sm transition-colors w-fit"
    >
      Leer artículo →
    </a>
  </div>
</article>
